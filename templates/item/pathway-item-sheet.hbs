                                        Levels
                                        <input
                                            type="number"
                                            min="0"
                                            max="10"
                                            step="1"
                                            value="{{sequence.attributeAdvancements.physical.dexterity.levels}}"
                                            data-pathway-field="sequence"
                                            data-sequence-index="{{sequence.index}}"
                                            data-sequence-property="attributeAdvancements.physical.dexterity.levels"
                                            {{#unless ../editable}}disabled{{/unless}}>
                                    </label>

                                    <label>
                                        Ceiling
                                        <input
                                            type="number"
                                            min="1"
                                            max="10"
                                            step="1"
                                            placeholder="—"
                                            value="{{sequence.attributeAdvancements.physical.dexterity.ceiling}}"
                                            data-pathway-field="sequence"
                                            data-sequence-index="{{sequence.index}}"
                                            data-sequence-property="attributeAdvancements.physical.dexterity.ceiling"
                                            {{#unless ../editable}}disabled{{/unless}}>
                                    </label>

                                </div>
                            </div>

                            {{!-- Stamina --}}
